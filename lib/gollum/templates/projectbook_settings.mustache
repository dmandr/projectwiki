<main id="wiki-wrapper" class="pb-settings-page" aria-labelledby="projectbook-settings-title">
  <div class="pb-settings-heading"><h1 id="projectbook-settings-title">Settings</h1></div>
  <p class="pb-settings-muted">For this deployment only. Settings are stored outside the book and are not synced through Git.</p>
  <nav class="pb-settings-tabs" role="tablist" aria-label="Settings sections">
    <a id="pb-semantic-tab" href="#semantic-search" role="tab" aria-selected="true" aria-controls="semantic-search">Semantic Search</a>
    <a id="pb-navigation-tab" href="#navigation" role="tab" aria-selected="false" aria-controls="navigation">Navigation</a>
  </nav>
  <section id="semantic-search" role="tabpanel" aria-labelledby="pb-semantic-tab">
  <p id="pb-settings-connection" role="status" aria-live="polite"></p>
  <p id="pb-settings-message" role="status" aria-live="polite"></p>
  <div class="pb-settings-columns">
  <form id="pb-settings-form">
    <fieldset id="pb-settings-fields" disabled>
      <legend>Semantic search <small>Experimental</small></legend>
      <label class="pb-settings-check"><input type="checkbox" name="enabled"> Enable semantic search</label>
      <p class="pb-settings-muted">First use downloads a local model (about 241 MB). Disabling stops new searches and indexing at a safe boundary; cached files are kept. A download or PDF already in progress may finish first.</p>
      <label class="pb-settings-check"><input type="checkbox" name="auto_index"> Update automatically after saved changes</label>
      <p class="pb-settings-muted">Checks the local Git revision at the interval below. Saved edits and changes received by Git pull are picked up automatically; unsaved drafts are excluded. This does not run Git pull.</p>
      <label class="pb-settings-check"><input type="checkbox" name="include_pdf"> Include PDF text (no OCR)</label>
      <div class="pb-settings-grid">
        <label>Check local Git every (seconds)<input type="number" name="poll_seconds" min="30" max="86400" required></label>
        <label>Indexing batch size<input type="number" name="batch_size" min="1" max="64" required></label>
        <label>Default search mode<select name="default_mode"><option value="hybrid">Hybrid</option><option value="semantic">Semantic</option><option value="keyword">Keyword</option></select></label>
        <label>Default result count<input type="number" name="result_limit" min="1" max="20" required></label>
      </div>
      <p class="pb-settings-muted">Batch size applies to the next indexing run. Larger batches can use more memory. Defaults apply when the MCP caller does not specify them.</p>
    </fieldset>
    <div class="pb-settings-buttons"><button class="btn" id="pb-settings-save" type="submit" disabled>Save settings</button><button class="btn" id="pb-settings-reload" type="button">Reload</button><button class="btn" id="pb-settings-index" type="button" disabled>Update index now</button></div>
  </form>
  <section class="pb-settings-status-card" aria-label="Search service status"><h3>Model and index</h3><p id="pb-settings-status">Loading…</p><p class="pb-settings-muted" id="pb-settings-model"></p></section>
  </div>
  <details class="pb-settings-explanation"><summary>How index updates work</summary>
    <p>No changes to the saved revision or indexing configuration means no rebuild. On a change, unchanged files reuse cached text and embeddings; a new complete search index is published when ready. Removed files disappear from the new index.</p>
    <p>The first run, enabling PDF text, or a manual update may also require indexing. Opening documents and searching do not trigger a rebuild. Git synchronization and direct save/pull event triggers are planned separately.</p>
  </details>
  </section>
  <section id="navigation" role="tabpanel" aria-labelledby="pb-navigation-tab" hidden>
    <h2>Tree editing</h2>
    <form id="pb-navigation-form">
      <label class="pb-settings-check"><input id="pb-confirm-move" type="checkbox" checked disabled> Confirm moving documents between folders</label>
      <p class="pb-settings-muted">Reordering within a folder saves immediately. Moving is unavailable while editing a document. Manual order is stored in Git as a hidden .order file and applies only to the tree.</p>
      <button class="btn" id="pb-navigation-save" type="submit" disabled>Save settings</button>
      <button class="btn" id="pb-navigation-reload" type="button">Reload</button>
      <p id="pb-navigation-message" role="status"></p>
    </form>
  </section>
</main>
<style>
#wiki-wrapper.pb-settings-page { max-width:1100px; margin:0 auto; padding:8px 0 32px; color:#273549; }
.pb-settings-heading { display:flex; align-items:center; justify-content:space-between; gap:16px; }
.pb-settings-heading h1 { margin:0; font-size:28px; font-weight:650; }
.pb-settings-tabs { display:flex; gap:24px; margin:26px 0 24px; }
.pb-settings-tabs a { padding:8px 0; color:#536b85; text-decoration:none; }
.pb-settings-tabs a[aria-selected="true"] { color:#154b80; border-bottom:2px solid #154b80; font-weight:600; }
.pb-settings-columns { display:grid; grid-template-columns:minmax(0,1fr) 270px; gap:32px; align-items:start; }
.pb-settings-status-card { border-radius:10px; background:#f6f8fb; padding:18px; overflow-wrap:anywhere; }
.pb-settings-status-card h3 { font-size:16px; margin:0 0 12px; }
.pb-settings-explanation { margin-top:28px; max-width:700px; color:#63748a; font-size:13px; line-height:1.6; }
.pb-settings-explanation summary { cursor:pointer; font-weight:600; color:#45566c; }
.pb-settings-explanation p { margin-top:12px; }
#pb-settings-message:empty, #pb-settings-connection:empty { display:none; }
#pb-settings-message { margin-bottom:16px; }
.pb-settings-muted { color:#63748a; font-size:13px; line-height:1.5; margin:10px 0; }
#pb-settings-fields { border:0; padding:0; margin-top:0; }
#pb-settings-fields legend { font-size:17px; font-weight:600; margin-bottom:14px; }
#pb-settings-fields small { font-size:11px; color:#63748a; margin-left:6px; }
.pb-settings-check { display:flex; align-items:center; gap:9px; margin:12px 0; font-weight:500; }
.pb-settings-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-top:16px; }
.pb-settings-grid label { display:flex; flex-direction:column; gap:6px; font-size:13px; }
.pb-settings-grid input, .pb-settings-grid select { padding:8px; border:1px solid #cbd5e1; border-radius:6px; background:white; width:100%; color:#273549; }
.pb-settings-buttons { display:flex; flex-wrap:wrap; gap:8px; margin-top:18px; }
#pb-settings-status { white-space:pre-line; font-size:14px; line-height:1.6; }
#pb-settings-message, #pb-settings-connection { color:#8a4100; }
@media(max-width:1100px) { .pb-settings-columns { grid-template-columns:1fr; } }
@media(max-width:480px) { .pb-settings-grid { grid-template-columns:1fr; } }

</style>
<script>
(() => {
  const form = document.getElementById('pb-settings-form');
  const fields = document.getElementById('pb-settings-fields');
  const message = document.getElementById('pb-settings-message');
  const connection = document.getElementById('pb-settings-connection');
  const save = document.getElementById('pb-settings-save');
  const index = document.getElementById('pb-settings-index');
  const reload = document.getElementById('pb-settings-reload');
  const state = document.getElementById('pb-settings-status');
  let baseline, version, editable = false, busy = false, loading = false, timer;
  const endpoint = baseUrl + '/gollum/projectbook/settings';
  const booleans = ['enabled','auto_index','include_pdf'];
  const numbers = ['poll_seconds','batch_size','result_limit'];
  const draft = () => Object.fromEntries(Object.keys(baseline || {}).map(key => [key, booleans.includes(key) ? form.elements[key].checked : numbers.includes(key) ? Number(form.elements[key].value) : form.elements[key].value]));
  const dirty = () => !!baseline && JSON.stringify(draft()) !== JSON.stringify(baseline);
  function buttons() { save.disabled = busy || !editable || !dirty(); fields.disabled = busy || !editable; }
  async function api(path = '', payload) {
    const response = await fetch(endpoint + path, payload === undefined ? {cache:'no-store'} : {method:'POST', headers:{'Content-Type':'application/json','X-ProjectWiki-Request':'1'},body:JSON.stringify(payload)});
    const data = await response.json(); if (!response.ok) throw new Error(data.error || 'Settings unavailable'); return data;
  }
  function renderStatus(data) {
    const s = data.status;
    if (!s) { state.textContent = data.message || 'Service not installed.'; return; }
    const report = s.report;
    const duration = report ? Math.round(report.total_seconds) : 0;
    state.textContent = [s.state === 'disabled' ? 'Semantic search is disabled.' : 'Index: ' + s.state,
      'Model: ' + (s.model_loaded ? 'loaded' : s.model_cached ? 'downloaded, not loaded' : 'not downloaded'),
      s.phase === 'model_download_and_load' ? 'Downloading or loading the model…' : '',
      s.state === 'indexing' ? 'Processed files: ' + (s.processed_files || 0) + ' · Fragments: ' + (s.chunks || 0) : '',
      report ? 'Published index: ' + report.files_indexed + ' files · ' + report.chunks + ' fragments' : 'No published index yet.',
      report ? 'Last indexing duration: ' + Math.floor(duration / 60) + ' min ' + (duration % 60) + ' s' : '',
      report?.finished_at ? 'Last indexed: ' + new Date(report.finished_at * 1000).toLocaleString() : '',
      report ? 'Files without indexed text: ' + report.errors.length : '',
      s.indexed_revision ? 'Documents: ' + (s.stale ? 'index needs an update' : 'up to date') : '',
      s.error || ''].filter(Boolean).join('\n');
    document.getElementById('pb-settings-model').textContent = (s.model || '') + ' · CPU threads: ' + s.threads + '. Model and CPU/memory limits are deployment settings.';
    index.disabled = busy || !data.editable || !s.settings?.enabled || s.state === 'indexing';
  }
  async function load(reset = false) {
    if (loading) return;
    loading = true;
    try {
      const data = await api(); renderStatus(data);
      connection.textContent = '';
      if (reset || !baseline) {
        editable = !!data.editable; fields.disabled = !editable; fields.hidden = !data.available;
        baseline = data.settings; version = data.version;
        if (baseline) Object.entries(baseline).forEach(([key,value]) => { if (booleans.includes(key)) form.elements[key].checked = value; else form.elements[key].value = value; });
        message.textContent = data.message || (!editable ? 'Viewing only. A deployment administrator can enable settings changes.' : '');
        buttons();
      }
    } catch(error) {
      connection.textContent = 'Cannot refresh settings. Retrying automatically; displayed status may be outdated. Your unsaved changes are kept.';
      index.disabled = true;
    } finally { loading = false; }
  }
  const startPolling = () => { clearInterval(timer); timer=setInterval(() => { if (!busy && !document.hidden) load(false); },5000); };
  load(true); startPolling();
  window.addEventListener('pagehide', () => clearInterval(timer));
  window.addEventListener('pageshow', startPolling);
  window.addEventListener('beforeunload', event => { if (dirty() || busy) { event.preventDefault(); event.returnValue=''; } });
  form.addEventListener('input', () => { buttons(); message.textContent = dirty() ? 'Unsaved settings.' : ''; });
  reload.addEventListener('click', () => { if (!dirty() || window.confirm('Discard unsaved settings and reload?')) load(true); });
  form.addEventListener('submit', async event => {
    event.preventDefault(); if (save.disabled) return;
    busy=true; buttons(); reload.disabled=true; index.disabled=true;
    try { const data=await api('', {settings:draft(),expected_version:version}); baseline=data.settings;version=data.version;renderStatus(data);message.textContent=data.unchanged?'No changes.':'Settings saved for this deployment.'; }
    catch(error) { message.textContent=error.message; }
    finally { busy=false; reload.disabled=false; buttons(); load(false); }
  });
  index.addEventListener('click', async () => { busy=true;index.disabled=true;buttons();try { await api('/index',{});message.textContent='Index update requested.'; } catch(error) {message.textContent=error.message;} finally {busy=false;buttons();load(false);} });
})();
</script>

<script>
(() => {
  const tabs = [...document.querySelectorAll('.pb-settings-tabs [role="tab"]')];
  function select() {
    const active = location.hash === '#navigation' ? 'navigation' : 'semantic-search';
    tabs.forEach(tab => { const yes = tab.getAttribute('aria-controls') === active; tab.setAttribute('aria-selected', String(yes)); document.getElementById(tab.getAttribute('aria-controls')).hidden = !yes; });
  }
  window.addEventListener('hashchange', select); select();
  const checkbox = document.getElementById('pb-confirm-move');
  const save = document.getElementById('pb-navigation-save');
  const message = document.getElementById('pb-navigation-message');
  let state, busy = false;
  function buttons() { checkbox.disabled = busy || !state?.editable; save.disabled = checkbox.disabled || checkbox.checked === state?.confirm_move; }
  async function request(payload) {
    const response = await fetch(baseUrl + '/gollum/projectbook/settings/navigation', payload ? {method:'POST',headers:{'Content-Type':'application/json','X-ProjectWiki-Request':'1'},body:JSON.stringify(payload)} : {cache:'no-store'});
    const data = await response.json(); if (!response.ok) throw new Error(data.error || 'Settings unavailable'); return data;
  }
  async function load() {
    try { state = await request(); checkbox.checked = state.confirm_move; message.textContent = state.editable ? '' : 'Deployment settings are read-only.'; }
    catch (error) { message.textContent = error.message; }
    buttons();
  }
  checkbox.addEventListener('change', buttons);
  document.getElementById('pb-navigation-reload').addEventListener('click', load);
  document.getElementById('pb-navigation-form').addEventListener('submit', async event => {
    event.preventDefault(); if (busy || save.disabled) return;
    busy = true; buttons();
    try { state = await request({version:state.version,confirm_move:checkbox.checked}); message.textContent = 'Settings saved.'; }
    catch (error) { message.textContent = error.message; }
    finally { busy = false; buttons(); }
  });
  load();
})();
</script>
