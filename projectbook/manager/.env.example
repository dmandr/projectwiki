# Use versioned images built for this host's architecture.
MANAGER_IMAGE=projectbook-manager:local
BOOK_IMAGE=projectwiki:local
RAG_IMAGE=projectbook-rag:local
QDRANT_IMAGE=qdrant/qdrant:v1.20.0
# local is ONLY for a loopback development deployment. Cloud uses cloudflare.
MANAGER_AUTH=cloudflare
ACCESS_ISSUER=https://YOUR-TEAM.cloudflareaccess.com
ADMIN_AUDIENCE=
MCP_AUDIENCE=
ADMIN_PUBLIC_URL=https://books.example.com
MCP_PUBLIC_URL=https://books-mcp.example.com/mcp
GIT_HOSTS=github.com
# Optional automatic Cloudflare provisioning. Set all IDs and install api-token
# in the projectbook-manager-cloudflare volume; never put the token in this file.
CF_ACCOUNT_ID=
CF_ZONE_ID=
CF_TUNNEL_ID=
CF_MCP_APP_ID=
CF_BASE_DOMAIN=dmandr.net

# GitHub App OAuth. Client secret goes in /run/github/client-secret, not here.
# With this enabled, new books require OAuth and belong to this personal account.
GITHUB_CLIENT_ID=
GITHUB_OWNER=
