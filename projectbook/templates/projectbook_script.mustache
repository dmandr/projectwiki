<script src="{{base_url}}/projectbook-editor/names.js"></script>
<script>
(function () {
  const header = document.querySelector('.projectbook-topbar');
  const tooltip = document.getElementById('projectbook-toolbar-tooltip');
  let tooltipOwner;
  function hideTooltip() {
    tooltip.hidden = true;
    tooltipOwner?.removeAttribute('aria-describedby');
    tooltipOwner = null;
  }
  function showTooltip(button) {
    hideTooltip(); tooltipOwner = button;
    tooltip.textContent = button.dataset.tooltip;
    tooltip.hidden = false;
    button.setAttribute('aria-describedby', tooltip.id);
    const rect = button.getBoundingClientRect();
    tooltip.style.left = Math.max(8, Math.min(rect.left + rect.width / 2 - tooltip.offsetWidth / 2, window.innerWidth - tooltip.offsetWidth - 8)) + 'px';
    tooltip.style.top = rect.bottom + 8 + 'px';
  }
  header.querySelectorAll('[data-tooltip]').forEach(button => {
    // Keep native title as a no-JavaScript fallback, not a second tooltip.
    button.removeAttribute('title');
    button.addEventListener('pointerenter', event => { if (event.pointerType !== 'touch') showTooltip(button); });
    button.addEventListener('pointerleave', hideTooltip);
    button.addEventListener('focus', () => showTooltip(button));
    button.addEventListener('blur', hideTooltip);
  });
  header.addEventListener('click', hideTooltip);
  document.addEventListener('keydown', event => { if (event.key === 'Escape') hideTooltip(); });
  window.addEventListener('scroll', hideTooltip, true);
  window.addEventListener('resize', hideTooltip);
  const tree = document.getElementById('projectbook-tree');
  const filter = document.getElementById('projectbook-search');
  document.getElementById('projectbook-print')?.addEventListener('click', () => window.print());
  const folders = Array.from(tree.querySelectorAll('li[data-folder]'));
  const links = Array.from(tree.querySelectorAll('a[data-document], a[data-folder-link]'));
  // New version deliberately ignores the prototype's initially-expanded state.
  const storageKey = 'projectwiki:tree:v2:' + baseUrl;
  let state = {};
  try { state = JSON.parse(localStorage.getItem(storageKey) || '{}'); } catch (_) {}
  if (!state || typeof state !== 'object' || Array.isArray(state)) state = {};
  const controls = new Map(folders.map(folder => [folder, {
    button: folder.querySelector(':scope > .projectbook-tree-row > button'),
    children: folder.querySelector(':scope > ul'),
    link: folder.querySelector(':scope > .projectbook-tree-row > a')
  }]));
  function expand(folder, open) {
    const {button, children, link} = controls.get(folder);
    children.hidden = !open;
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', (open ? 'Collapse ' : 'Expand ') + link.textContent);
    button.title = button.getAttribute('aria-label');
  }
  function save() {
    try { localStorage.setItem(storageKey, JSON.stringify(state)); } catch (_) {}
  }
  for (const folder of folders) {
    expand(folder, state[folder.dataset.folder] === true);
    controls.get(folder).button.addEventListener('click', () => {
      const open = controls.get(folder).children.hidden;
      expand(folder, open);
      if (!filter.value.trim()) { state[folder.dataset.folder] = open; save(); }
    });
  }
  let current = decodeURIComponent(location.pathname).replace(/\/$/, '');
  const editing = current.startsWith(baseUrl + '/gollum/edit/') || current.startsWith(baseUrl + '/gollum/create/');
  const editPrefix = baseUrl + '/gollum/edit/';
  if (current.startsWith(editPrefix)) current = baseUrl + '/' + current.slice(editPrefix.length);
  for (const link of links) {
    const path = decodeURIComponent(new URL(link.href).pathname).replace(/\/$/, '');
    if (path === current || (link.hasAttribute('data-document') && path.replace(/\.(md|markdown)$/i, '') === current)) {
      link.setAttribute('aria-current', 'page');
      link.closest('.projectbook-tree-row, .projectbook-file').classList.add('projectbook-selected');
    }
  }
  const nav = document.getElementById('projectbook-nav');
  // Keep attachment links portable in Markdown, but open them in the wiki viewer.
  document.addEventListener('DOMContentLoaded', () => {
    const previews = new Map(links.filter(link => link.href.includes('/gollum/file/')).map(link => [baseUrl + '/' + link.dataset.document, link.href]));
    for (const link of document.querySelectorAll('#wiki-body a[href]')) {
      const url = new URL(link.href);
      if (url.origin !== location.origin || url.search) continue;
      try { const preview = previews.get(decodeURIComponent(url.pathname)); if (preview) link.href = preview + url.hash; } catch (_) {}
    }
  });
  function plainClick(event) {
    return event.button === 0 && !event.altKey && !event.ctrlKey && !event.metaKey && !event.shiftKey;
  }
  for (const link of links) link.addEventListener('click', event => {
    if (!plainClick(event)) return;
    if (link.hasAttribute('data-folder-link')) {
      const folder = link.closest('li[data-folder]');
      const selected = link.getAttribute('aria-current') === 'page' && !editing;
      const open = selected ? controls.get(folder).children.hidden : true;
      expand(folder, open);
      state[folder.dataset.folder] = open;
      save();
      if (selected) event.preventDefault();
    } else if (link.getAttribute('aria-current') === 'page' && !editing) {
      event.preventDefault();
    } else {
      // Preserve the route exposed by a search when opening one of its results.
      for (let ancestor = link.closest('li').parentElement.closest('li[data-folder]'); ancestor; ancestor = ancestor.parentElement.closest('li[data-folder]')) {
        state[ancestor.dataset.folder] = true;
      }
      save();
    }
  });
  function expandAll(open) {
    if (filter.value.trim()) {
      folders.filter(folder => !folder.hidden).forEach(folder => expand(folder, open));
      return;
    }
    links.forEach(link => { link.closest('li').hidden = false; });
    folders.forEach(folder => { state[folder.dataset.folder] = open; expand(folder, open); });
    document.getElementById('projectbook-empty').hidden = links.length !== 0;
    save();
  }
  document.getElementById('projectbook-expand').addEventListener('click', () => expandAll(true));
  document.getElementById('projectbook-collapse').addEventListener('click', () => expandAll(false));
  function applyFilter() {
    try { sessionStorage.setItem(storageKey + ':query', filter.value); } catch (_) {}
    const query = filter.value.trim().toLocaleLowerCase().replaceAll('_', ' ');
    for (const link of links) {
      const path = link.dataset.document || link.dataset.folderLink;
      link.closest('li').hidden = !(path + ' ' + link.textContent).toLocaleLowerCase().replaceAll('_', ' ').includes(query);
    }
    for (const folder of folders.slice().reverse()) {
      const ownMatch = !folder.hidden;
      const childMatch = Array.from(controls.get(folder).children.children).some(child => !child.hidden);
      folder.hidden = !ownMatch && !childMatch;
      expand(folder, query ? childMatch : state[folder.dataset.folder] === true);
    }
    document.getElementById('projectbook-empty').hidden = Array.from(tree.querySelector(':scope > ul').children).some(item => !item.hidden);
  }
  filter.addEventListener('input', applyFilter);
  filter.addEventListener('search', applyFilter);
  filter.addEventListener('keydown', event => {
    if (event.key === 'Escape') { event.preventDefault(); filter.value = ''; applyFilter(); }
  });
  const requestedQuery = new URL(location.href).searchParams;
  if (requestedQuery.has('q')) filter.value = requestedQuery.get('q');
  else { try { filter.value = sessionStorage.getItem(storageKey + ':query') || ''; } catch (_) {} }
  applyFilter();
  // Arrow keys navigate currently visible rows; Enter follows links, Space toggles buttons.
  tree.addEventListener('keydown', event => {
    if (event.altKey || event.ctrlKey || event.metaKey) return;
    const target = event.target.closest('a, button');
    if (!target) return;
    const row = target.closest('li');
    const folder = row.hasAttribute('data-folder') ? row : null;
    const visible = [...tree.querySelectorAll('a[data-document],a[data-folder-link]')].filter(link => !link.closest('[hidden]'));
    const link = folder ? controls.get(folder).link : target;
    let next;
    if (event.key === 'ArrowDown') next = visible[visible.indexOf(link) + 1];
    else if (event.key === 'ArrowUp') next = visible[visible.indexOf(link) - 1];
    else if (event.key === 'ArrowRight' && folder) {
      if (controls.get(folder).children.hidden) controls.get(folder).button.click();
      else next = visible[visible.indexOf(link) + 1];
    } else if (event.key === 'ArrowLeft') {
      if (folder && !controls.get(folder).children.hidden) controls.get(folder).button.click();
      else next = row.parentElement.closest('li[data-folder]')?.querySelector(':scope > .projectbook-tree-row > a');
    } else return;
    event.preventDefault();
    next?.focus();
  });
  nav.style.visibility = 'visible';
  // Renaming submits a separate form: never leave unsaved editor text behind.
  document.addEventListener('click', event => {
    if (!event.target.closest('.minibutton-rename-page')) return;
    if (window.projectbookRename) { event.preventDefault(); event.stopImmediatePropagation(); window.projectbookRename(); return; }
    const editor = document.getElementById('gollum-editor-form');
    if (!editor) return;
    const body = document.getElementById('gollum-editor-body');
    const changedBody = window.projectbookEditorDirty?.() || (body && (window.ace_editor?.getValue() ?? body.value) !== body.defaultValue);
    const changedExtras = Array.from(editor.querySelectorAll('textarea[name=header], textarea[name=footer], textarea[name=sidebar]')).some(field => field.value !== field.defaultValue);
    const notice = document.getElementById('projectbook-action-notice');
    if (changedBody || changedExtras) {
      event.preventDefault(); event.stopImmediatePropagation();
      notice.textContent = 'Save your changes before renaming this document.'; notice.hidden = false;
    } else { notice.hidden = true; }
  }, true);
  const dialog = document.getElementById('projectbook-create-dialog');
  if (!dialog) return;
  const form = document.getElementById('projectbook-create-form');
  const folderSelect = document.getElementById('projectbook-create-folder');
  const defaultFolder = folderSelect.value;
  const nameInput = document.getElementById('projectbook-create-name');
  const pathInput = document.getElementById('projectbook-create-destination');
  const names = window.projectbookNames;
  const submit = document.getElementById('projectbook-create-submit');
  const error = document.getElementById('projectbook-create-error');
  let kind = 'document', busy = false;
  function previewPath(resetFolder = false) {
    const slug = names.slugFromTitle(nameInput.value);
    const name = kind === 'document' ? (slug ? slug + '.md' : '') : nameInput.value;
    const parent = resetFolder || kind === 'folder' ? folderSelect.value : pathInput.value.split('/').slice(0, -1).join('/');
    pathInput.value = parent ? parent + '/' + name : name;
    document.getElementById('projectbook-create-path').textContent = '/' + pathInput.value;
  }
  document.querySelectorAll('[data-create-kind]').forEach(button => button.addEventListener('click', () => {
    folderSelect.querySelectorAll('[data-proposed]').forEach(option => option.remove());
    folderSelect.value = defaultFolder;
    kind = button.dataset.createKind;
    document.getElementById('projectbook-create-title').textContent = kind === 'folder' ? 'New folder' : 'New document';
    submit.textContent = kind === 'folder' ? 'Create folder' : 'Create and edit';
    document.querySelector('label[for="projectbook-create-name"]').textContent = kind === 'folder' ? 'Name' : 'Title';
    document.getElementById('projectbook-create-destination-row').hidden = kind === 'folder';
    document.getElementById('projectbook-create-hint').textContent = kind === 'folder' ? 'Creates an empty folder in the book.' : 'Title suggests a filename; editing the path generates a title. After creation, Title and Move work independently.';
    nameInput.value = ''; error.hidden = true; previewPath(true); dialog.showModal(); nameInput.focus();
  }));
  nameInput.addEventListener('input', () => previewPath());
  nameInput.addEventListener('blur', () => { if (kind === 'document') nameInput.value = names.titleFromInput(nameInput.value); });
  pathInput.addEventListener('input', () => {
    nameInput.value = names.titleFromPath(pathInput.value);
    const parent = pathInput.value.replace(/^\/+/, '').split('/').slice(0, -1).join('/');
    if (![...folderSelect.options].some(option => option.value === parent)) {
      const option = new Option('/' + parent + ' (new)', parent); option.dataset.proposed = 'true'; folderSelect.add(option);
    }
    folderSelect.value = parent;
    document.getElementById('projectbook-create-path').textContent = '/' + pathInput.value;
  });
  folderSelect.addEventListener('change', () => previewPath(true));
  document.getElementById('projectbook-create-cancel').addEventListener('click', () => { if (!busy) dialog.close(); });
  dialog.addEventListener('cancel', event => { if (busy) event.preventDefault(); });
  form.addEventListener('submit', async event => {
    event.preventDefault();
    if (busy) return;
    busy = true; submit.disabled = true; error.hidden = true;
    try {
      let destination = pathInput.value.replace(/^\/+/, '');
      if (!/\.md$/i.test(destination)) destination += '.md';
      const input = kind === 'document' ? {kind, title: names.titleFromInput(nameInput.value), path: destination} : {kind, folder: folderSelect.value, name: nameInput.value};
      const response = await fetch(baseUrl + '/gollum/projectbook/new', {method: 'POST', headers: {'Content-Type': 'application/json', 'X-ProjectWiki-Request': '1'}, body: JSON.stringify(input)});
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.error || 'Could not create: HTTP ' + response.status);
      // Expand the destination path on the next page without disturbing other branches.
      const parts = (kind === 'document' ? destination.split('/').slice(0, -1).join('/') : folderSelect.value).split('/').filter(Boolean);
      if (kind === 'folder') parts.push(nameInput.value);
      parts.forEach((_, index) => { state[parts.slice(0, index + 1).join('/')] = true; }); save();
      location.assign(result.url);
    } catch (failure) {
      error.textContent = failure instanceof TypeError ? 'No server confirmation. Check Files before retrying; a folder may already have been created.' : failure.message;
      error.hidden = false;
    } finally { busy = false; submit.disabled = false; }
  });
})();
</script>
