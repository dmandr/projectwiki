<div id="wiki-wrapper" class="pb-editor-page">
  <div id="head">{{>navbar}}</div>
  <form id="gollum-editor-form" data-create="{{is_create_page}}" data-uploads="{{allow_uploads}}" data-path="{{projectbook_editor_path}}" data-etag="{{etag}}">
    <textarea id="projectbook-initial-markdown" hidden>{{content}}</textarea>
    <div id="projectbook-editor-app"><p>Loading editor…</p></div>
    <noscript>JavaScript is required to edit this document.</noscript>
  </form>
</div>
